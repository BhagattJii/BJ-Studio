# Public app URL (used for metadata/OG)
# Google OAuth Client ID (public, safe to expose)
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID (Web application)
# Enable "Google Drive API" in the same project.
# Authorized JavaScript origins: http://localhost:3000 and your deployed URL.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Clerk publishable key (public, safe to expose)
# clerk.com -> Create application -> enable Google social connection -> copy Publishable key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk secret key (server-only, never commit/expose)
CLERK_SECRET_KEY=
